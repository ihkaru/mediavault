# ==============================================================================
# MediaVault Environment Configuration
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8080

# Master API Key (Bearer token or X-API-Key header).
# If left empty, API is publicly accessible without authentication.
API_KEY=mv_live_secret_key_change_me

# SQLite Embedded Database Path
DATABASE_URL=sqlite:/app/data/mediavault.db?mode=rwc

# Storage Configuration
# Options: "local" (default filesystem) or "s3" (Garage, Cloudflare R2, AWS S3, MinIO)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/app/data/storage
STORAGE_TEMP_DIR=/app/data/temp

# Garage / S3 Compatible Storage (Only needed when STORAGE_BACKEND=s3)
S3_ENDPOINT=http://garage:3900
S3_BUCKET=mediavault
S3_REGION=garage
S3_ACCESS_KEY=your_garage_access_key
S3_SECRET_KEY=your_garage_secret_key
S3_PUBLIC_URL=https://s3.yourdomain.com

# Meilisearch Instant Search Engine (Pure-Rust)
MEILI_ENABLED=true
MEILI_HOST=http://meilisearch:7700
MEILI_API_KEY=meili_master_key_123456
MEILI_INDEX=mediavault_files

# Media Ingestion Limits & Processing
MAX_UPLOAD_SIZE_MB=250
THUMBNAIL_MAX_WIDTH=400
THUMBNAIL_MAX_HEIGHT=400

# Logging & Observability
RUST_LOG=mediavault=info,tower_http=info
